<?xml version="1.0" encoding="utf-8"?>
<resources>
    <bool name="config_enableAuxCameras">true</bool>

    <string-array name="config_additionalVideoConfigurations">
        <!-- 480p and 720p: 30/60fps supported -->
        <item>0</item>
        <item>sd|hd</item>
        <item>30|60</item>
        <!-- 1080p: only 30fps, 60fps explicitly unsupported -->
        <item>0</item>
        <item>fhd</item>
        <item>30|-60</item>
        <!-- 4k: only 30fps, 24/60/120fps explicitly unsupported -->
        <item>0</item>
        <item>uhd</item>
        <item>30|-24|-60|-120</item>
    </string-array>

    <string-array name="config_logicalZoomRatios">
        <item>0</item>
        <item>2.0</item>
        <item>5.0</item>
    </string-array>
</resources>
